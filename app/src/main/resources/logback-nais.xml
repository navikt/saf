<?xml version="1.0" encoding="UTF-8"?>
<included>
	<include resource="org/springframework/boot/logging/logback/defaults.xml"/>

	<appender name="applikasjonslogg" class="ch.qos.logback.core.ConsoleAppender">
		<encoder class="net.logstash.logback.encoder.LogstashEncoder">
			<throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
				<maxDepthPerThrowable>30</maxDepthPerThrowable>
				<exclude>java\.util\.concurrent\..*</exclude>
				<exclude>org\.apache\.tomcat\..*</exclude>
				<exclude>org\.apache\.coyote\..*</exclude>
				<exclude>org\.apache\.catalina\..*</exclude>
				<exclude>org\.springframework\.web\..*</exclude>
				<exclude>sun\.net\.www\..*</exclude>
				<exclude>io\.reactivex\.internal\..*</exclude>
			</throwableConverter>
		</encoder>
	</appender>

	<appender name="hentdokument_sporbarhetslogg" class="net.logstash.logback.appender.LogstashTcpSocketAppender">
		<destination>audit.nais:6514</destination>
		<writeBufferSize>128000</writeBufferSize>
		<encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
			<pattern>${HOSTNAME} saf_audit_hentdokument: %m%n</pattern>
		</encoder>
	</appender>

	<logger level="INFO" name="hentdokument_sporbarhetslogg" additivity="false">
		<appender-ref ref="hentdokument_sporbarhetslogg"/>
	</logger>

	<root level="WARN">
		<appender-ref ref="applikasjonslogg"/>
	</root>

	<logger name="no.nav.saf" level="INFO" additivity="false">
		<appender-ref ref="applikasjonslogg"/>
	</logger>
</included>