{
  tilknyttedeJournalposter(dokumentInfoId: "500000000", tilknytning: GJENBRUK) {
    journalpostId
    tittel
    journalposttype
    journalstatus
    tema
    temanavn
    behandlingstema
    behandlingstemanavn
    avsenderMottaker {
      id
      navn
      land
      erLikBruker
    }
    avsenderMottakerId
    avsenderMottakerNavn
    avsenderMottakerLand
    journalforendeEnhet
    journalfoerendeEnhet
    journalfortAvNavn
    opprettetAvNavn
    kanal
    kanalnavn
    datoOpprettet
    relevanteDatoer {
      dato
      datotype
    }
    tilleggsopplysninger {
      nokkel
      verdi
    }
    sak {
      arkivsaksnummer
      arkivsaksystem
      datoOpprettet
      fagsakId
      fagsaksystem
      sakstype
    }
    bruker {
      id
      type
    }
    dokumenter {
      dokumentInfoId
      tittel
      brevkode
      dokumentstatus
      originalJournalpostId
      logiskeVedlegg {
        tittel
      }
      dokumentvarianter {
        variantformat
        saksbehandlerHarTilgang
      }
    }
  }
}
