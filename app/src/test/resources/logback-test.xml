<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	<include resource="org/springframework/boot/logging/logback/defaults.xml"/>
	<include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

	<root level="WARN">
		<appender-ref ref="CONSOLE"/>
	</root>

	<logger name="no.nav.saf" level="INFO" additivity="false">
		<appender-ref ref="CONSOLE"/>
	</logger>

	<logger level="INFO" name="sporbarhetslogg" additivity="false">
		<appender-ref ref="CONSOLE"/>
	</logger>

	<logger level="INFO" name="hentdokument_sporbarhetslogg" additivity="false">
		<appender-ref ref="CONSOLE"/>
	</logger>

</configuration>